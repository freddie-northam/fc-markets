# Copy to .env for local development. docker-compose supplies these values.
DATABASE_URL=postgres://fcmarket:fcmarket@localhost:5434/fcmarket

OBJECT_STORE_ENDPOINT=http://localhost:9002
OBJECT_STORE_BUCKET=fc-market-raw
OBJECT_STORE_ACCESS_KEY=fcmarket
OBJECT_STORE_SECRET_KEY=fcmarketsecret

# Only needed when a provider requires one.
SOURCE_API_KEY=

# Stops a run before it exhausts the provider quota.
DAILY_REQUEST_BUDGET=18000
HTTP_TIMEOUT_SECONDS=30

# Compression needs free space for a compressed copy before it drops the
# original, and a full volume stops PostgreSQL.
MIN_FREE_DISK_BYTES=5368709120

# External dead man's switch. A pull check on a failing host cannot report that
# the host is gone. Leave empty to disable.
HEARTBEAT_URL=

API_ROW_CAP=5000
BIND_ADDRESS=0.0.0.0:8080

NEXT_PUBLIC_API_URL=http://localhost:8080
