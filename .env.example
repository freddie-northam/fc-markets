# Copy to .env for local development. docker-compose supplies these values.
DATABASE_URL=postgres://fcmarket:fcmarket@localhost:5434/fcmarket

OBJECT_STORE_ENDPOINT=http://localhost:9002
OBJECT_STORE_BUCKET=fc-market-raw
OBJECT_STORE_ACCESS_KEY=fcmarket
OBJECT_STORE_SECRET_KEY=fcmarketsecret

# Which provider the run reads: fixture (payloads from disk) or futdb.
SOURCE=fixture
SOURCE_BASE_URL=https://api.fut-db.com
# Only needed when a provider requires one. SOURCE=futdb refuses to start
# without it, because the provider answers every request with 401.
SOURCE_API_KEY=

# Stops a run before it exhausts the provider quota. FUT-DB allows 20,000 a day
# on a rolling window, and one request prices a card on both platforms.
DAILY_REQUEST_BUDGET=18000
HTTP_TIMEOUT_SECONDS=30

# Compression needs free space for a compressed copy before it drops the
# original, and a full volume stops PostgreSQL.
MIN_FREE_DISK_BYTES=5368709120
# The filesystem to measure. It must be the database's data volume, not the
# server's own working directory. docker-compose mounts it read only.
DISK_CHECK_PATH=.

# External dead man's switch. A pull check on a failing host cannot report that
# the host is gone. Leave empty to disable.
HEARTBEAT_URL=

API_ROW_CAP=5000
BIND_ADDRESS=0.0.0.0:8090

NEXT_PUBLIC_API_URL=http://localhost:8090
