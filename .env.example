# Copy to .env for local development. docker-compose supplies these values.
DATABASE_URL=postgres://fcmarket:fcmarket@localhost:5434/fcmarket

OBJECT_STORE_ENDPOINT=http://localhost:9002
OBJECT_STORE_BUCKET=fc-market-raw
OBJECT_STORE_ACCESS_KEY=fcmarket
OBJECT_STORE_SECRET_KEY=fcmarketsecret
# MinIO serves paths and ignores the region. A hosted store usually serves
# virtual hosted buckets and states its own region, and the wrong setting fails
# at the first request rather than at start.
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_PATH_STYLE=true

# Which provider the run reads: fixture (payloads from disk) or futdb.
SOURCE=fixture
SOURCE_BASE_URL=https://api.fut-db.com
# Only needed when a provider requires one. SOURCE=futdb refuses to start
# without it, because the provider answers every request with 401.
SOURCE_API_KEY=

# Stops a run before it exhausts the provider quota. FUT-DB allows 20,000 a day
# on a rolling window, and one request prices a card on both platforms.
DAILY_REQUEST_BUDGET=18000
HTTP_TIMEOUT_SECONDS=30

# How stale the newest poll may get before /health calls it an outage. Stated,
# not derived from the polling bands: the daily request budget is what bounds
# polling, so a healthy system routinely goes most of a day without one. 30 hours.
MAX_POLL_AGE_SECONDS=108000

# Compression needs free space for a compressed copy before it drops the
# original, and a full volume stops PostgreSQL. Keep this well below the
# volume's size: a floor equal to the volume can never be met.
MIN_FREE_DISK_BYTES=5368709120
# The filesystem to measure. It must be the database's data volume, not the
# server's own working directory. docker-compose mounts it read only.
DISK_CHECK_PATH=.
# Set this INSTEAD of DISK_CHECK_PATH where the server cannot see the
# database's volume, which is the case on any platform that gives each service
# its own volume. The size then comes from the database and is taken from this
# capacity. Example for a 50 GB volume: 53687091200
DATABASE_VOLUME_BYTES=

# The two outbound signals, deliberately opposite. Both optional, and
# complementary rather than alternatives.
#
# The heartbeat's SILENCE is the alarm: it pings only when a run closes healthy,
# so one mechanism covers a dead host, a dead process and a dead feed. It needs a
# third party watching for the silence.
HEARTBEAT_URL=
# The webhook's MESSAGE is the alarm: it posts to a chat channel, so a human
# notices instead of a service. It cannot report its own death. Discord rejects a
# payload it does not recognise, so the body shape is not incidental.
ALERT_WEBHOOK_URL=

API_ROW_CAP=5000
BIND_ADDRESS=0.0.0.0:8090

NEXT_PUBLIC_API_URL=http://localhost:8090
